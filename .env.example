# Copy to .env and adjust. Never commit .env.
IMDA_USER_AGENT="india-merchant-data-api/0.1 (+https://github.com/MohitGoyal09/india-merchant-data-api; contact: you@example.com)"
IMDA_DB_PATH=data/imda.sqlite3
IMDA_UPSTREAM_ENABLED=true
IMDA_MIN_INTERVAL_SECONDS=2.0
IMDA_REQUEST_BUDGET=500
# Required for write endpoints (webhooks, manual refresh). Generate: python -c "import secrets;print(secrets.token_urlsafe(32))"
IMDA_ADMIN_TOKEN=
IMDA_ALLOW_PRIVATE_WEBHOOKS=false
IMDA_CLOSING_OF_ACCOUNTS_IS_HOLIDAY=true
IMDA_SETTLEMENT_CYCLE_DAYS=2
